// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// DOMAIN 1: CORE STRUCTURE (Admin manages)
// ============================================================

model CoreMinistry {
  id        BigInt   @id @default(autoincrement())
  code      String   @unique @db.VarChar(50)
  name      String   @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  departments CoreDepartment[]

  @@map("core_ministries")
}

model CoreDepartment {
  id         BigInt   @id @default(autoincrement())
  ministryId BigInt   @map("ministry_id")
  name       String   @db.Text
  code       String   @unique @db.VarChar(50)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz

  ministry    CoreMinistry     @relation(fields: [ministryId], references: [id], onDelete: Restrict)
  officeTypes CoreOfficeType[]
  offices     CoreOffice[]     @relation("DepartmentOffices")

  @@map("core_departments")
}

model CoreOfficeType {
  id            BigInt   @id @default(autoincrement())
  departmentId  BigInt   @map("department_id")
  name          String   @db.Text
  isGroupBudget Boolean  @default(false) @map("is_group_budget")
  sortOrder     Int      @default(1) @map("sort_order")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz

  department     CoreDepartment           @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  officeLevels   CoreOfficeLevel[]
  offices        CoreOffice[]
  vehicleConfigs AdminVehicleConfig[]
  rentConfigs    AdminVehicleRentConfig[]
  itConfigs      AdminItConfig[]
  groupRules     AdminGroupBudgetRule[]

  @@map("core_office_types")
}

model CoreOfficeLevel {
  id           BigInt   @id @default(autoincrement())
  officeTypeId BigInt   @map("office_type_id")
  levelName    String   @map("level_name") @db.Text
  levelOrder   Int      @default(1) @map("level_order")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  officeType   CoreOfficeType                   @relation(fields: [officeTypeId], references: [id], onDelete: Cascade)
  offices      CoreOffice[]
  codeMappings OfficeLevelEconomicCodeMapping[]
  groupRules   AdminGroupBudgetRule[]

  @@map("core_office_levels")
}

model CoreOffice {
  id             BigInt   @id @default(autoincrement())
  budgetId       String   @unique @map("budget_id") @db.VarChar(50)
  name           String   @db.Text
  departmentId   BigInt   @map("department_id")
  officeTypeId   BigInt   @map("office_type_id")
  officeLevelId  BigInt?  @map("office_level_id")
  parentOfficeId BigInt?  @map("parent_office_id")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  department   CoreDepartment     @relation(fields: [departmentId], references: [id], onDelete: Restrict, name: "DepartmentOffices")
  officeType   CoreOfficeType     @relation(fields: [officeTypeId], references: [id], onDelete: Restrict)
  officeLevel  CoreOfficeLevel?   @relation(fields: [officeLevelId], references: [id], onDelete: SetNull)
  parentOffice CoreOffice?        @relation("OfficeHierarchy", fields: [parentOfficeId], references: [id], onDelete: SetNull)
  childOffices CoreOffice[]       @relation("OfficeHierarchy")
  officeUsers  OfficeUser[]
  submissions  OfficeSubmission[]

  @@map("core_offices")
}

model CoreBudgetCycle {
  id           BigInt    @id @default(autoincrement())
  fiscalYearId BigInt    @map("fiscal_year_id")
  budgetTypeId BigInt    @map("budget_type_id")
  title        String    @db.Text
  status       String    @default("closed") @db.VarChar(20)
  openedAt     DateTime? @map("opened_at") @db.Timestamptz
  closedAt     DateTime? @map("closed_at") @db.Timestamptz
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  fiscalYear RefFiscalYear @relation(fields: [fiscalYearId], references: [id])
  budgetType RefBudgetType @relation(fields: [budgetTypeId], references: [id])

  submissions OfficeSubmission[]

  @@unique([fiscalYearId, budgetTypeId])
  @@map("core_budget_cycles")
}

// ============================================================
// DOMAIN 2: REFERENCE DATA (Admin configures)
// ============================================================

model RefGrade {
  id          Int      @id @default(autoincrement())
  gradeNo     Int      @unique @map("grade_no")
  category    String   @db.VarChar(20)
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  staffWorking     OfficeFormStaffWorking[]
  staffSuspended   OfficeFormStaffSuspended[]
  staffNewRecruits OfficeFormStaffNewRecruit[]

  @@map("ref_grades")
}

model RefBudgetCategory {
  id        BigInt   @id @default(autoincrement())
  code      String   @unique @db.VarChar(20)
  title     String   @db.Text
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  economicCodes RefEconomicCode[]

  @@map("ref_budget_categories")
}

model RefBudgetType {
  id        BigInt   @id @default(autoincrement())
  name      String   @unique @db.Text
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  cycles CoreBudgetCycle[]

  @@map("ref_budget_types")
}

model RefFiscalYear {
  id        BigInt   @id @default(autoincrement())
  year      String   @unique @db.VarChar(20)
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  cycles CoreBudgetCycle[]

  @@map("ref_fiscal_years")
}

model RefEconomicCode {
  id         BigInt   @id @default(autoincrement())
  code       String   @unique @db.VarChar(20)
  name       String   @db.Text
  categoryId BigInt?  @map("category_id")
  isManual   Boolean  @default(true) @map("is_manual")
  formulaKey String?  @map("formula_key") @db.VarChar(100)
  sortOrder  Int      @default(0) @map("sort_order")
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz

  category     RefBudgetCategory?            @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  codeMappings OfficeLevelEconomicCodeMapping[]
  budgetSheets OfficeBudgetSheet[]

  @@index([categoryId])
  @@map("ref_economic_codes")
}

model OfficeLevelEconomicCodeMapping {
  id             BigInt   @id @default(autoincrement())
  officeLevelId  BigInt   @map("office_level_id")
  economicCodeId BigInt   @map("economic_code_id")
  isEnabled      Boolean  @default(true) @map("is_enabled")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  officeLevel  CoreOfficeLevel @relation(fields: [officeLevelId], references: [id], onDelete: Cascade)
  economicCode RefEconomicCode @relation(fields: [economicCodeId], references: [id], onDelete: Cascade)

  @@unique([officeLevelId, economicCodeId])
  @@index([officeLevelId, isEnabled])
  @@index([economicCodeId])
  @@map("office_level_economic_code_mapping")
}

model RefAllowanceType {
  id                 BigInt   @id @default(autoincrement())
  name               String   @unique @db.Text
  labelBn            String?  @map("label_bn") @db.Text
  countLabelBn       String?  @map("count_label_bn") @db.Text
  isCalculated       Boolean  @default(false) @map("is_calculated")
  formulaKey         String?  @map("formula_key") @db.VarChar(100)
  applicableCategory String?  @map("applicable_category") @db.VarChar(20)
  hasBasic           Boolean  @default(false) @map("has_basic")
  hasAmount          Boolean  @default(false) @map("has_amount")
  hasDue             Boolean  @default(false) @map("has_due")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz

  allowances OfficeFormAllowance[]

  @@map("ref_allowance_types")
}

model RefVehicleType {
  id        BigInt   @id @default(autoincrement())
  name      String   @unique @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  vehicleConfigs AdminVehicleConfig[]
  rentConfigs    AdminVehicleRentConfig[]

  @@map("ref_vehicle_types")
}

model RefFuelType {
  id        BigInt   @id @default(autoincrement())
  name      String   @unique @db.Text
  unitPrice Decimal  @default(0) @map("unit_price") @db.Decimal(14, 2)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  vehicleConfigs AdminVehicleConfig[]

  @@map("ref_fuel_types")
}

model RefItEquipmentType {
  id        BigInt   @id @default(autoincrement())
  name      String   @unique @db.Text
  unitPrice Decimal  @default(0) @map("unit_price") @db.Decimal(14, 2)
  hasToner  Boolean  @default(false) @map("has_toner")
  isLumpsum Boolean  @default(false) @map("is_lumpsum")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  itConfigs AdminItConfig[]

  @@map("ref_it_equipment_types")
}

model RefUtilityType {
  id        BigInt   @id @default(autoincrement())
  name      String   @unique @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  utilities OfficeFormUtility[]

  @@map("ref_utility_types")
}

// ============================================================
// DOMAIN 3: ADMIN CONFIGURATION (Rates & Defaults)
// ============================================================

model AdminRate {
  id          BigInt   @id @default(autoincrement())
  key         String   @unique @db.VarChar(50)
  name        String   @db.Text
  value       Decimal  @db.Decimal(14, 2)
  unit        String   @default("টাকা") @db.VarChar(20)
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  houseRents  OfficeFormHouseRent[]
  returnInfos OfficeFormReturnInfo[]

  @@map("admin_rates")
}

// The /admin/settings "বেতন-ভাতা" tab. Each row is one tile: a scalar rate
// (`input_type = 'number'`), a rate applied to a grade range (`'grade'`), or a
// grade-banded table whose rows live in AdminSalarySlab (`'slab'`). The tile
// list itself is data, so adding a row here adds a tile with no code change.
model AdminSalaryConfig {
  id            BigInt   @id @default(autoincrement())
  key           String   @unique @db.VarChar(50)
  labelBn       String   @map("label_bn") @db.Text
  descriptionBn String?  @map("description_bn") @db.Text
  unitBn        String   @default("") @map("unit_bn") @db.VarChar(30)
  inputType     String   @default("number") @map("input_type") @db.VarChar(20)
  valueFormat   String   @default("number") @map("value_format") @db.VarChar(20)
  value         Decimal  @default(0) @db.Decimal(14, 2)
  fromGrade     Int?     @map("from_grade")
  toGrade       Int?     @map("to_grade")
  sortOrder     Int      @default(0) @map("sort_order")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz

  slabs AdminSalarySlab[]

  @@map("admin_salary_config")
}

model AdminSalarySlab {
  id        BigInt   @id @default(autoincrement())
  configKey String   @map("config_key") @db.VarChar(50)
  fromGrade Int      @map("from_grade")
  toGrade   Int      @map("to_grade")
  value     Decimal  @db.Decimal(14, 2)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  config AdminSalaryConfig @relation(fields: [configKey], references: [key], onDelete: Cascade)

  @@map("admin_salary_slabs")
}

model AdminVehicleConfig {
  id                         BigInt   @id @default(autoincrement())
  officeTypeId               BigInt?  @map("office_type_id")
  vehicleTypeId              BigInt   @map("vehicle_type_id")
  fuelTypeId                 BigInt   @map("fuel_type_id")
  monthlyFuelQuotaLiter      Decimal? @default(0) @map("monthly_fuel_quota_liter") @db.Decimal(10, 2)
  annualLubeAllowance        Decimal? @default(0) @map("annual_lube_allowance") @db.Decimal(14, 2)
  annualMaintenanceAllowance Decimal? @default(0) @map("annual_maintenance_allowance") @db.Decimal(14, 2)
  createdAt                  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                  DateTime @updatedAt @map("updated_at") @db.Timestamptz

  officeType  CoreOfficeType?         @relation(fields: [officeTypeId], references: [id], onDelete: Cascade)
  vehicleType RefVehicleType          @relation(fields: [vehicleTypeId], references: [id], onDelete: Cascade)
  fuelType    RefFuelType             @relation(fields: [fuelTypeId], references: [id], onDelete: Cascade)
  vehicles    OfficeFormVehicleGovt[]

  @@unique([vehicleTypeId, fuelTypeId])
  @@map("admin_vehicle_config")
}

model AdminVehicleRentConfig {
  id              BigInt   @id @default(autoincrement())
  officeTypeId    BigInt?  @map("office_type_id")
  vehicleTypeId   BigInt   @map("vehicle_type_id")
  monthlyRentRate Decimal? @default(0) @map("monthly_rent_rate") @db.Decimal(14, 2)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz

  officeType  CoreOfficeType?         @relation(fields: [officeTypeId], references: [id], onDelete: Cascade)
  vehicleType RefVehicleType          @relation(fields: [vehicleTypeId], references: [id], onDelete: Cascade)
  vehicles    OfficeFormVehicleRent[]

  @@unique([vehicleTypeId])
  @@map("admin_vehicle_rent_config")
}

model AdminItConfig {
  id              BigInt   @id @default(autoincrement())
  officeTypeId    BigInt   @map("office_type_id")
  equipmentTypeId BigInt   @map("equipment_type_id")
  unitBudget      Decimal? @default(0) @map("unit_budget") @db.Decimal(14, 2)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz

  officeType    CoreOfficeType          @relation(fields: [officeTypeId], references: [id], onDelete: Cascade)
  equipmentType RefItEquipmentType      @relation(fields: [equipmentTypeId], references: [id], onDelete: Cascade)
  equipments    OfficeFormItEquipment[]

  @@unique([officeTypeId, equipmentTypeId])
  @@map("admin_it_config")
}

// ============================================================
// DOMAIN 4: OFFICE DATA (Offices fill forms)
// ============================================================

model OfficeUser {
  id           BigInt    @id @default(autoincrement())
  officeId     BigInt    @unique @map("office_id")
  passwordHash String    @map("password_hash") @db.Text
  passwordHint String?   @default("12345") @map("password_hint") @db.Text
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  office CoreOffice @relation(fields: [officeId], references: [id], onDelete: Cascade)

  @@map("office_users")
}

model OfficeSubmission {
  id              BigInt    @id @default(autoincrement())
  officeId        BigInt    @map("office_id")
  cycleId         BigInt    @map("cycle_id")
  status          String    @default("draft") @db.VarChar(20)
  submittedAt     DateTime? @map("submitted_at") @db.Timestamptz
  reviewedBy      BigInt?   @map("reviewed_by")
  reviewedAt      DateTime? @map("reviewed_at") @db.Timestamptz
  rejectionReason String?   @map("rejection_reason") @db.Text
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  office           CoreOffice                  @relation(fields: [officeId], references: [id], onDelete: Restrict)
  cycle            CoreBudgetCycle             @relation(fields: [cycleId], references: [id], onDelete: Restrict)
  reviewer         AdminUser?                  @relation(fields: [reviewedBy], references: [id])
  formBasic        OfficeFormBasic?
  staffWorking     OfficeFormStaffWorking[]
  staffSuspended   OfficeFormStaffSuspended[]
  staffNewRecruits OfficeFormStaffNewRecruit[]
  allowances       OfficeFormAllowance[]
  leaveEncashment  OfficeFormLeaveEncashment?
  vehiclesGovt     OfficeFormVehicleGovt[]
  vehiclesRent     OfficeFormVehicleRent[]
  houseRent        OfficeFormHouseRent?
  itEquipments     OfficeFormItEquipment[]
  utilities        OfficeFormUtility[]
  returnInfo       OfficeFormReturnInfo?
  budgetSheets     OfficeBudgetSheet[]

  @@unique([officeId, cycleId])
  @@map("office_submissions")
}

model OfficeFormBasic {
  id           BigInt   @id @default(autoincrement())
  submissionId BigInt   @unique @map("submission_id")
  headOfOffice String   @map("head_of_office") @db.Text
  designation  String?  @db.Text
  phone        String?  @db.VarChar(30)
  email        String?  @db.VarChar(100)
  address      String?  @db.Text
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  submission OfficeSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@map("office_form_basic")
}

model OfficeFormStaffWorking {
  id           BigInt   @id @default(autoincrement())
  submissionId BigInt   @map("submission_id")
  gradeId      Int      @map("grade_id")
  staffCount   Int      @default(0) @map("staff_count")
  monthlyBasic Decimal  @default(0) @map("monthly_basic") @db.Decimal(14, 2)
  dueSalary    Decimal  @default(0) @map("due_salary") @db.Decimal(14, 2)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  submission OfficeSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  grade      RefGrade         @relation(fields: [gradeId], references: [gradeNo])

  @@unique([submissionId, gradeId])
  @@map("office_form_staff_working")
}

model OfficeFormStaffSuspended {
  id                    BigInt   @id @default(autoincrement())
  submissionId          BigInt   @map("submission_id")
  gradeId               Int      @map("grade_id")
  suspendedCount        Int      @default(0) @map("suspended_count")
  suspendedMonthlyBasic Decimal  @default(0) @map("suspended_monthly_basic") @db.Decimal(14, 2)
  suspendedDueSalary    Decimal  @default(0) @map("suspended_due_salary") @db.Decimal(14, 2)
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime @updatedAt @map("updated_at") @db.Timestamptz

  submission OfficeSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  grade      RefGrade         @relation(fields: [gradeId], references: [gradeNo])

  @@unique([submissionId, gradeId])
  @@map("office_form_staff_suspended")
}

model OfficeFormStaffNewRecruit {
  id              BigInt   @id @default(autoincrement())
  submissionId    BigInt   @map("submission_id")
  gradeId         Int      @map("grade_id")
  recruitCount    Int      @default(0) @map("recruit_count")
  monthlyBasic    Decimal  @default(0) @map("monthly_basic") @db.Decimal(14, 2)
  joiningDate     DateTime @map("joining_date") @db.Date
  monthsRemaining Int      @default(12) @map("months_remaining")
  totalSalary     Decimal  @default(0) @map("total_salary") @db.Decimal(14, 2)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz

  submission OfficeSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  grade      RefGrade         @relation(fields: [gradeId], references: [gradeNo])

  @@map("office_form_staff_new_recruits")
}

model OfficeFormAllowance {
  id                BigInt    @id @default(autoincrement())
  submissionId      BigInt    @map("submission_id")
  allowanceTypeId   BigInt    @map("allowance_type_id")
  officerCount      Int       @default(0) @map("officer_count")
  staffCount        Int       @default(0) @map("staff_count")
  totalBasic        Decimal   @default(0) @map("total_basic") @db.Decimal(14, 2)
  totalAnnualAmount Decimal   @default(0) @map("total_annual_amount") @db.Decimal(14, 2)
  dueAmount         Decimal   @default(0) @map("due_amount") @db.Decimal(14, 2)
  effectiveDate     DateTime? @map("effective_date") @db.Date
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  submission    OfficeSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  allowanceType RefAllowanceType @relation(fields: [allowanceTypeId], references: [id])

  @@unique([submissionId, allowanceTypeId])
  @@map("office_form_allowances")
}

model OfficeFormLeaveEncashment {
  id                          BigInt   @id @default(autoincrement())
  submissionId                BigInt   @unique @map("submission_id")
  leaveEncashmentOfficerBasic Decimal  @default(0) @map("leave_encashment_officer_basic") @db.Decimal(14, 2)
  leaveEncashmentOfficerDue   Decimal  @default(0) @map("leave_encashment_officer_due") @db.Decimal(14, 2)
  leaveEncashmentStaffBasic   Decimal  @default(0) @map("leave_encashment_staff_basic") @db.Decimal(14, 2)
  leaveEncashmentStaffDue     Decimal  @default(0) @map("leave_encashment_staff_due") @db.Decimal(14, 2)
  restRecreationAmount        Decimal  @default(0) @map("rest_recreation_amount") @db.Decimal(14, 2)
  restRecreationDue           Decimal  @default(0) @map("rest_recreation_due") @db.Decimal(14, 2)
  createdAt                   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  submission OfficeSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@map("office_form_leave_encashment")
}

model OfficeFormVehicleGovt {
  id                BigInt   @id @default(autoincrement())
  submissionId      BigInt   @map("submission_id")
  vehicleConfigId   BigInt   @map("vehicle_config_id")
  vehicleCount      Int      @default(0) @map("vehicle_count")
  maintenanceDue    Decimal? @map("maintenance_due") @db.Decimal(14, 2)
  additionalExpense Decimal  @default(0) @map("additional_expense") @db.Decimal(14, 2)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz

  submission OfficeSubmission   @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  config     AdminVehicleConfig @relation(fields: [vehicleConfigId], references: [id])

  @@unique([submissionId, vehicleConfigId])
  @@map("office_form_vehicles_govt")
}

model OfficeFormVehicleRent {
  id                  BigInt   @id @default(autoincrement())
  submissionId        BigInt   @map("submission_id")
  vehicleRentConfigId BigInt   @map("vehicle_rent_config_id")
  vehicleCount        Int      @default(0) @map("vehicle_count")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz

  submission OfficeSubmission       @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  config     AdminVehicleRentConfig @relation(fields: [vehicleRentConfigId], references: [id])

  @@unique([submissionId, vehicleRentConfigId])
  @@map("office_form_vehicles_rent")
}

