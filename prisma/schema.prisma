// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================
// DOMAIN 1: CORE STRUCTURE (Admin manages)
// ============================================================

model CoreMinistry {
  id        BigInt   @id @default(autoincrement())
  code      String   @unique @db.VarChar(50)
  name      String   @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  departments  CoreDepartment[]
  /// A ministry is itself a budget-owning entity: it holds a budget ID and a login, so it
  /// owns an office row of its own (see core_offices.ministry_id).
  offices      CoreOffice[]      @relation("MinistryOffices")
  /// The level the admin grants economic codes against for this ministry.
  officeLevels CoreOfficeLevel[]

  @@map("core_ministries")
}

model CoreDepartment {
  id         BigInt   @id @default(autoincrement())
  ministryId BigInt   @map("ministry_id")
  name       String   @db.Text
  code       String   @unique @db.VarChar(50)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz

  ministry     CoreMinistry      @relation(fields: [ministryId], references: [id], onDelete: Restrict)
  officeTypes  CoreOfficeType[]
  offices      CoreOffice[]      @relation("DepartmentOffices")
  /// Like a ministry, a department is a budget-owning entity with its own login and level.
  officeLevels CoreOfficeLevel[]

  @@map("core_departments")
}

model CoreOfficeType {
  id            BigInt   @id @default(autoincrement())
  departmentId  BigInt   @map("department_id")
  name          String   @db.Text
  sortOrder     Int      @default(1) @map("sort_order")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz

  department     CoreDepartment           @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  officeLevels   CoreOfficeLevel[]
  offices        CoreOffice[]
  itConfigs      AdminItConfig[]
  groupRules     AdminGroupBudgetRule[]

  @@map("core_office_types")
}

model CoreOfficeLevel {
  id           BigInt   @id @default(autoincrement())
  /// A level belongs to exactly one owner: a ministry, a department, or an office type.
  /// Office-type levels are the field-office hierarchy; ministry/department levels let the
  /// admin grant economic codes to those entities (grants are keyed by level).
  officeTypeId BigInt?  @map("office_type_id")
  ministryId   BigInt?  @map("ministry_id")
  departmentId BigInt?  @map("department_id")
  levelName    String   @map("level_name") @db.Text
  levelOrder   Int      @default(1) @map("level_order")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  officeType   CoreOfficeType?                  @relation(fields: [officeTypeId], references: [id], onDelete: Cascade)
  ministry     CoreMinistry?                    @relation(fields: [ministryId], references: [id], onDelete: Cascade)
  department   CoreDepartment?                  @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  offices      CoreOffice[]
  codeMappings OfficeLevelEconomicCodeMapping[]
  groupRules   AdminGroupBudgetRule[]

  @@map("core_office_levels")
}

model CoreOffice {
  id             BigInt   @id @default(autoincrement())
  budgetId       String   @unique @map("budget_id") @db.VarChar(50)
  name           String   @db.Text
  /// A ministry/department office links straight to its ministry; an ordinary office links
  /// to a department and an office type. Exactly one ownership style applies per row.
  ministryId     BigInt?  @map("ministry_id")
  departmentId   BigInt?  @map("department_id")
  officeTypeId   BigInt?  @map("office_type_id")
  officeLevelId  BigInt?  @map("office_level_id")
  parentOfficeId BigInt?  @map("parent_office_id")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  ministry     CoreMinistry?       @relation("MinistryOffices", fields: [ministryId], references: [id], onDelete: Restrict)
  department   CoreDepartment?     @relation(fields: [departmentId], references: [id], onDelete: Restrict, name: "DepartmentOffices")
  officeType   CoreOfficeType?     @relation(fields: [officeTypeId], references: [id], onDelete: Restrict)
  officeLevel  CoreOfficeLevel?    @relation(fields: [officeLevelId], references: [id], onDelete: Restrict)
  parentOffice CoreOffice?         @relation("OfficeHierarchy", fields: [parentOfficeId], references: [id], onDelete: SetNull)
  childOffices CoreOffice[]        @relation("OfficeHierarchy")
  officeUsers  OfficeUser[]
  submissions  OfficeSubmission[]

  @@map("core_offices")
}

model CoreBudgetCycle {
  id           BigInt    @id @default(autoincrement())
  fiscalYearId BigInt    @map("fiscal_year_id")
  budgetTypeId BigInt    @map("budget_type_id")
  title        String    @db.Text
  /// বেতন-মাস — months in this cycle's fiscal year. Every monthly figure in the
  /// sheet is annualised with it, so the value lives on the cycle, not globally.
  salaryMonths Int       @default(12) @map("salary_months")
  status       String    @default("closed") @db.VarChar(20)
  openedAt     DateTime? @map("opened_at") @db.Timestamptz
  closedAt     DateTime? @map("closed_at") @db.Timestamptz
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  fiscalYear RefFiscalYear @relation(fields: [fiscalYearId], references: [id])
  budgetType RefBudgetType @relation(fields: [budgetTypeId], references: [id])

  submissions OfficeSubmission[]

  @@unique([fiscalYearId, budgetTypeId])
  @@map("core_budget_cycles")
}

// ============================================================
// DOMAIN 2: REFERENCE DATA (Admin configures)
// ============================================================

/**
 * The two employee categories a pay grade belongs to: কর্মকর্তা (officer) and
 * কর্মচারী (staff). Held as reference data rather than a free-text tag so the
 * grade list — and every calculation that splits officers from staff — follows
 * one table instead of a guess at a grade-number boundary.
 */
model RefEmployeeCategory {
  id             BigInt   @id @default(autoincrement())
  categoryName   String   @unique @map("category_name") @db.VarChar(20)
  categoryNameBn String   @map("category_name_bn") @db.Text
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  grades RefGrade[]

  @@map("ref_employee_categories")
}

model RefGrade {
  id          Int      @id @default(autoincrement())
  gradeNo     Int      @unique @map("grade_no")
  categoryId  BigInt   @map("category_id")
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  category RefEmployeeCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  staffWorking     OfficeFormStaffWorking[]
  staffSuspended   OfficeFormStaffSuspended[]
  staffNewRecruits OfficeFormStaffNewRecruit[]

  @@index([categoryId])
  @@map("ref_grades")
}

model RefBudgetCategory {
  id        BigInt   @id @default(autoincrement())
  code      String   @unique @db.VarChar(20)
  title     String   @db.Text
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  economicCodes RefEconomicCode[]

  @@map("ref_budget_categories")
}

/// The formulas the calculation engine can run (see `formulaRegistry` in
/// src/lib/budget/calculate.ts). The *logic* of a formula is code — it is a
/// computation, not a value — but which formula an economic code or allowance
/// uses is data: an administrator points a code at one of these keys and the
/// engine picks it up with no code change. `key` is what the code side joins on.
model RefFormulaType {
  id        BigInt   @id @default(autoincrement())
  key       String   @unique @db.VarChar(100)
  labelBn   String   @map("label_bn") @db.Text
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  economicCodes  RefEconomicCode[]
  allowanceTypes RefAllowanceType[]

  @@map("ref_formula_types")
}

model RefBudgetType {
  id        BigInt   @id @default(autoincrement())
  name      String   @unique @db.Text
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  cycles CoreBudgetCycle[]

  @@map("ref_budget_types")
}

model RefFiscalYear {
  id        BigInt   @id @default(autoincrement())
  year      String   @unique @db.VarChar(20)
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  cycles CoreBudgetCycle[]

  @@map("ref_fiscal_years")
}

model RefEconomicCode {
  id         BigInt   @id @default(autoincrement())
  code       String   @unique @db.VarChar(20)
  name       String   @db.Text
  categoryId BigInt?  @map("category_id")
  isManual   Boolean  @default(true) @map("is_manual")
  // A code the engine computes but the office may still override in the budget
  // sheet (currently only ডাক, whose amount depends on a count the engine can
  // only estimate). Manual codes ignore this flag — they always take an input.
  allowManualOverride Boolean @default(false) @map("allow_manual_override")
  /// Which engine formula computes this code (see RefFormulaType). A manual code
  /// leaves this null; a computed one names the formula the engine dispatches to.
  /// The engine's registry is keyed by this value, never by the code itself, so a
  /// new code reusing an existing formula is an admin row, not a code change.
  formulaKey String?  @map("formula_key") @db.VarChar(100)
  /// The form numbers whose data produced this code's amount, so the budget sheet
  /// can point the office at the form to edit. Empty for a manual code.
  sourceForms Int[]   @default([]) @map("source_forms")
  sortOrder  Int      @default(0) @map("sort_order")
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz

  category     RefBudgetCategory?            @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  formula      RefFormulaType?               @relation(fields: [formulaKey], references: [key], onDelete: SetNull)
  codeMappings OfficeLevelEconomicCodeMapping[]
  budgetSheets OfficeBudgetSheet[]
  snapshotRows OfficeBudgetSnapshotRow[]
  utilityTypes RefUtilityType[]
  fuelCategories RefFuelCategory[]

  @@index([categoryId])
  @@map("ref_economic_codes")
}

model OfficeLevelEconomicCodeMapping {
  id             BigInt   @id @default(autoincrement())
  officeLevelId  BigInt   @map("office_level_id")
  economicCodeId BigInt   @map("economic_code_id")
  isEnabled      Boolean  @default(true) @map("is_enabled")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  officeLevel  CoreOfficeLevel @relation(fields: [officeLevelId], references: [id], onDelete: Cascade)
  economicCode RefEconomicCode @relation(fields: [economicCodeId], references: [id], onDelete: Cascade)

  @@unique([officeLevelId, economicCodeId])
  @@index([officeLevelId, isEnabled])
  @@index([economicCodeId])
  @@map("office_level_economic_code_mapping")
}

model RefAllowanceType {
  id                 BigInt   @id @default(autoincrement())
  name               String   @unique @db.Text
  labelBn            String?  @map("label_bn") @db.Text
  countLabelBn       String?  @map("count_label_bn") @db.Text
  isCalculated       Boolean  @default(false) @map("is_calculated")
  /// The engine formula that consumes this allowance's figures (see RefFormulaType),
  /// so the budget engine matches an allowance by formula rather than by its name.
  formulaKey         String?  @map("formula_key") @db.VarChar(100)
  applicableCategory String?  @map("applicable_category") @db.VarChar(20)
  hasBasic           Boolean  @default(false) @map("has_basic")
  hasAmount          Boolean  @default(false) @map("has_amount")
  hasDue             Boolean  @default(false) @map("has_due")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz

  formula    RefFormulaType?     @relation(fields: [formulaKey], references: [key], onDelete: SetNull)
  allowances OfficeFormAllowance[]

  @@map("ref_allowance_types")
}

model RefVehicleType {
  id        BigInt   @id @default(autoincrement())
  name      String   @unique @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  vehicleConfigs AdminVehicleConfig[]
  rentConfigs    AdminVehicleRentConfig[]
  /// প্রতি ধরনের জন্য একটিই লুব্রিকেন্ট ও রক্ষণাবেক্ষণ বরাদ্দ।
  allowanceConfig AdminVehicleAllowanceConfig?

  @@map("ref_vehicle_types")
}

model RefFuelCategory {
  id             BigInt   @id @default(autoincrement())
  /// স্থায়ী কী ('oil' / 'gas') — ইঞ্জিন দুটি জ্বালানি কোড (3243301 / 3243302) এই মান দিয়ে আলাদা করে।
  categoryName   String   @unique @map("category_name") @db.VarChar(20)
  /// ব্যবহারকারীকে দেখানো বাংলা নাম (তেল / গ্যাস)।
  categoryNameBn String   @map("category_name_bn") @db.Text
  /// ব্যয়টি যে অর্থনৈতিক কোডে যাবে (৩২৪৩৩০১ / ৩২৪৩৩০২)। কোডের `formula_key`
  /// ইঞ্জিনকে বলে কীভাবে যোগ করতে হবে — এখানে কোডটি শুধু ডেটা, নামের অনুমান নয়।
  economicCodeId BigInt?  @map("economic_code_id")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  economicCode   RefEconomicCode?   @relation(fields: [economicCodeId], references: [id], onDelete: SetNull)
  fuelTypes      RefFuelType[]
  vehicleConfigs AdminVehicleConfig[]

  @@index([economicCodeId])
  @@map("ref_fuel_categories")
}

model RefFuelType {
  id         BigInt   @id @default(autoincrement())
  name       String   @unique @db.Text
  unitPrice  Decimal  @default(0) @map("unit_price") @db.Decimal(14, 2)
  /// জ্বালানির ধরন (তেল / গ্যাস) — 3243301 ও 3243302 কোড দুটি এভাবে আলাদা হয়।
  categoryId BigInt   @map("category_id")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  category       RefFuelCategory        @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  officeVehicles OfficeFormVehicleGovt[]

  @@index([categoryId])
  @@map("ref_fuel_types")
}

model RefItEquipmentType {
  id        BigInt   @id @default(autoincrement())
  name      String   @unique @db.Text
  unitPrice Decimal  @default(0) @map("unit_price") @db.Decimal(14, 2)
  hasToner  Boolean  @default(false) @map("has_toner")
  isLumpsum Boolean  @default(false) @map("is_lumpsum")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  itConfigs AdminItConfig[]

  @@map("ref_it_equipment_types")
}

model RefUtilityType {
  id        BigInt   @id @default(autoincrement())
  name      String   @unique @db.Text
  /// ইউটিলিটির বিলটি যে অর্থনৈতিক কোডে যাবে (৩২১১১১৩ বিদ্যুৎ / ৩২১১১১৫ পানি /
  /// ৩২১১১১৭ ইন্টারনেট / ৩২১১১২০ টেলিফোন)। ইঞ্জিন নাম মেলায় না — এই কোডটাই যোগ করে।
  economicCodeId BigInt? @map("economic_code_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  economicCode RefEconomicCode?   @relation(fields: [economicCodeId], references: [id], onDelete: SetNull)
  utilities    OfficeFormUtility[]

  @@index([economicCodeId])
  @@map("ref_utility_types")
}

// ============================================================
// DOMAIN 3: ADMIN CONFIGURATION (Rates & Defaults)
// ============================================================

// The /admin/settings "বেতন-ভাতা" tab. Each row is one tile: a scalar rate
// (`input_type = 'number'`), a rate applied to a grade range (`'grade'`), or a
// grade-banded table whose rows live in AdminSalarySlab (`'slab'`). The tile
// list itself is data, so adding a row here adds a tile with no code change.
model AdminSalaryConfig {
  id               BigInt   @id @default(autoincrement())
  key              String   @unique @db.VarChar(50)
  labelBn          String   @map("label_bn") @db.Text
  descriptionBn    String?  @map("description_bn") @db.Text
  unitBn           String   @default("") @map("unit_bn") @db.VarChar(30)
  inputType        String   @default("number") @map("input_type") @db.VarChar(20)
  valueFormat      String   @default("number") @map("value_format") @db.VarChar(20)
  value            Decimal  @default(0) @db.Decimal(14, 2)
  fromGrade        Int?     @map("from_grade")
  toGrade          Int?     @map("to_grade")
  // Some cards are a rate × quantity pair rather than a single number (ডাক = per-notice
  // cost × notices served per non-filer). `secondaryLabelBn` marks such a card and names
  // the companion value; a card without it renders exactly one input. Both values are the
  // administrator's to set, so no multiplier is compiled into the engine.
  secondaryLabelBn String?  @map("secondary_label_bn") @db.Text
  secondaryUnitBn  String   @default("") @map("secondary_unit_bn") @db.VarChar(30)
  secondaryValue   Decimal  @default(0) @map("secondary_value") @db.Decimal(14, 2)
  sortOrder        Int      @default(0) @map("sort_order")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz

  slabs AdminSalarySlab[]

  @@map("admin_salary_config")
}

model AdminSalarySlab {
  id        BigInt   @id @default(autoincrement())
  configKey String   @map("config_key") @db.VarChar(50)
  fromGrade Int      @map("from_grade")
  toGrade   Int      @map("to_grade")
  value     Decimal  @db.Decimal(14, 2)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  config AdminSalaryConfig @relation(fields: [configKey], references: [key], onDelete: Cascade)

  @@map("admin_salary_slabs")
}

model AdminVehicleConfig {
  id                         BigInt   @id @default(autoincrement())
  vehicleTypeId              BigInt   @map("vehicle_type_id")
  /// জ্বালানির ধরন (তেল / গ্যাস) — একই ধরনের সব জ্বালানি একই অর্থনৈতিক কোডে ব্যয় হয়,
  /// তাই কনফিগারেশনটি নির্দিষ্ট জ্বালানের বদলে ধরন চেনে।
  fuelCategoryId             BigInt   @map("fuel_category_id")
  monthlyFuelQuotaLiter      Decimal? @default(0) @map("monthly_fuel_quota_liter") @db.Decimal(10, 2)
  createdAt                  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                  DateTime @updatedAt @map("updated_at") @db.Timestamptz

  vehicleType  RefVehicleType          @relation(fields: [vehicleTypeId], references: [id], onDelete: Cascade)
  fuelCategory RefFuelCategory         @relation(fields: [fuelCategoryId], references: [id], onDelete: Restrict)
  vehicles     OfficeFormVehicleGovt[]

  @@unique([vehicleTypeId, fuelCategoryId])
  @@index([fuelCategoryId])
  @@map("admin_vehicle_config")
}

/// প্রতি ধরনের যানবাহনের জন্য একটিই লুব্রিকেন্ট ও রক্ষণাবেক্ষণ বরাদ্দ। একটি জিপ যেমন
/// তেল ও গ্যাস দুটোই ব্যবহার করতে পারে, তবু বরাদ্দটি একবারই — জ্বালানি অনুযায়ী শুধু
/// মাসিক পরিমাণটুকুই আলাদা, তাই সেটি admin_vehicle_config-এ থাকে।
model AdminVehicleAllowanceConfig {
  id                         BigInt   @id @default(autoincrement())
  vehicleTypeId              BigInt   @unique @map("vehicle_type_id")
  annualLubeAllowance        Decimal? @default(0) @map("annual_lube_allowance") @db.Decimal(14, 2)
  annualMaintenanceAllowance Decimal? @default(0) @map("annual_maintenance_allowance") @db.Decimal(14, 2)
  createdAt                  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                  DateTime @updatedAt @map("updated_at") @db.Timestamptz

  vehicleType RefVehicleType @relation(fields: [vehicleTypeId], references: [id], onDelete: Cascade)

  @@map("admin_vehicle_allowance_config")
}

model AdminVehicleRentConfig {
  id              BigInt   @id @default(autoincrement())
  vehicleTypeId   BigInt   @map("vehicle_type_id")
  monthlyRentRate Decimal? @default(0) @map("monthly_rent_rate") @db.Decimal(14, 2)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz

  vehicleType RefVehicleType          @relation(fields: [vehicleTypeId], references: [id], onDelete: Cascade)
  vehicles    OfficeFormVehicleRent[]

  @@unique([vehicleTypeId])
  @@map("admin_vehicle_rent_config")
}

model AdminItConfig {
  id              BigInt   @id @default(autoincrement())
  officeTypeId    BigInt   @map("office_type_id")
  equipmentTypeId BigInt   @map("equipment_type_id")
  unitBudget      Decimal? @default(0) @map("unit_budget") @db.Decimal(14, 2)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz

  officeType    CoreOfficeType          @relation(fields: [officeTypeId], references: [id], onDelete: Cascade)
  equipmentType RefItEquipmentType      @relation(fields: [equipmentTypeId], references: [id], onDelete: Cascade)
  equipments    OfficeFormItEquipment[]

  @@unique([officeTypeId, equipmentTypeId])
  @@map("admin_it_config")
