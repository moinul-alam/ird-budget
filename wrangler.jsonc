{
	"$schema": "node_modules/wrangler/config-schema.json",
	// Must match the Worker in the Cloudflare dashboard (`budget`); wrangler otherwise deploys to
	// a second, empty Worker that has none of the dashboard's variables, secrets or domains.
	"name": "budget",
	// The bundle produced by `opennextjs-cloudflare build`.
	"main": ".open-next/worker.js",
	// Wrangler treats this file, not the dashboard, as the source of truth for bindings, so a
	// deploy would otherwise drop any plaintext variable set in the dashboard (DATABASE_URL,
	// ADMIN_DEFAULT_PASSWORD, ...). Encrypted secrets survive a deploy regardless; this guards
	// the plaintext ones.
	"keep_vars": true,
	"compatibility_date": "2026-10-23",
	// `nodejs_compat` is what makes `pg` work: it needs node:net, node:tls and node:crypto,
	// which is how the Prisma driver adapter (src/lib/db/client.ts) reaches PostgreSQL.
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	// Only used by next/image — served from Cloudflare Images. If the binding is absent the
	// adapter logs a warning and serves the original file, so this is not load-bearing.
	"images": {
		"binding": "IMAGES"
	}
}
